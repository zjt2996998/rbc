{
  "compilerOptions": {
    /* Output control */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",

    /* Code quality */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,

    /* Imports and modules */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,

    /* Emit control (Vite handles actual build) */
    "noEmit": true,
    
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
